{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/credential-reference.schema.json",
  "title": "Opaque Credential Broker Mock Reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reference_id",
    "engagement_id",
    "target_id",
    "purpose",
    "issued_at",
    "expires_at",
    "state"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "reference_id": {"type": "string", "pattern": "^cref-[a-f0-9]{32}$"},
    "engagement_id": {"type": "string", "pattern": "^eng-[a-z0-9-]{3,64}$"},
    "target_id": {"type": "string", "pattern": "^tgt-[a-z0-9-]{3,64}$"},
    "purpose": {"enum": ["synthetic_target_auth", "mock_patch_validation"]},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "state": {"enum": ["active", "revoked", "expired"]}
  }
}
