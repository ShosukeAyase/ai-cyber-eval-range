{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/transition-event.schema.json",
  "title": "State Transition Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transition_id",
    "machine",
    "object_id",
    "from_state",
    "to_state",
    "reason",
    "occurred_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "transition_id": {"type": "string", "pattern": "^trn-[a-z0-9-]{3,64}$"},
    "machine": {"enum": ["engagement", "approval", "job", "runner"]},
    "object_id": {"type": "string", "pattern": "^(eng|apr|job|run)-[a-z0-9-]{3,64}$"},
    "from_state": {"type": "string", "pattern": "^[a-z][a-z_]{2,31}$"},
    "to_state": {"type": "string", "pattern": "^[a-z][a-z_]{2,31}$"},
    "reason": {"type": "string", "minLength": 3, "maxLength": 240},
    "occurred_at": {"type": "string", "format": "date-time"}
  }
}
