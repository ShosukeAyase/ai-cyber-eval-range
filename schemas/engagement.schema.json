{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/engagement.schema.json",
  "title": "Engagement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "engagement_id",
    "name",
    "status",
    "valid_from",
    "valid_until",
    "target_ids",
    "scenario_ids",
    "model_profile",
    "budgets",
    "roe_ref",
    "policy_version",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "engagement_id": {
      "type": "string",
      "pattern": "^eng-[a-z0-9-]{3,64}$"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160
    },
    "status": {
      "enum": [
        "draft",
        "validated",
        "approved",
        "active",
        "stopping",
        "closed",
        "terminated"
      ]
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "target_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^tgt-[a-z0-9-]{3,64}$"
      }
    },
    "scenario_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^scn-[a-z0-9-]{3,64}$"
      }
    },
    "model_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model_family",
        "tier",
        "reasoning_effort",
        "context_policy_id"
      ],
      "properties": {
        "provider": {
          "const": "openai"
        },
        "model_family": {
          "const": "gpt-5.6"
        },
        "tier": {
          "enum": [
            "sol",
            "terra",
            "luna"
          ]
        },
        "reasoning_effort": {
          "enum": [
            "low",
            "medium",
            "high",
            "max"
          ]
        },
        "context_policy_id": {
          "type": "string",
          "pattern": "^ctx-[a-z0-9-]{3,64}$"
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_wall_seconds",
        "max_model_tokens",
        "max_tool_calls",
        "max_parallel_jobs",
        "max_network_bytes"
      ],
      "properties": {
        "max_wall_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "max_model_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_parallel_jobs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_network_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000000
        }
      }
    },
    "roe_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roe_id",
        "version",
        "digest"
      ],
      "properties": {
        "roe_id": {
          "type": "string",
          "pattern": "^roe-[a-z0-9-]{3,64}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "digest",
        "value",
        "signed_at"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "ed25519",
            "ecdsa-p256-sha256"
          ]
        },
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{3,128}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "value": {
          "type": "string",
          "minLength": 32,
          "maxLength": 4096
        },
        "signed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
