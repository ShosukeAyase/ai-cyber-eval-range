{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/tool-request.schema.json",
  "title": "Structured Tool Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "engagement_id",
    "target_id",
    "test_case_id",
    "action_class",
    "tool_id",
    "arguments"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string", "pattern": "^req-[a-z0-9-]{3,64}$"},
    "engagement_id": {"type": "string", "pattern": "^eng-[a-z0-9-]{3,64}$"},
    "target_id": {"type": "string", "pattern": "^tgt-[a-z0-9-]{3,64}$"},
    "test_case_id": {"type": "string", "pattern": "^tc-[a-z0-9-]{3,64}$"},
    "action_class": {
      "enum": [
        "read_only_analysis",
        "safe_discovery",
        "safe_test",
        "state_change",
        "credentialed_test",
        "poc_validation",
        "patch_validation",
        "range_reset",
        "engagement_termination"
      ]
    },
    "tool_id": {
      "enum": [
        "run_static_analysis",
        "run_safe_network_discovery",
        "run_web_test",
        "request_poc_validation",
        "collect_evidence",
        "propose_patch",
        "validate_patch",
        "reset_range",
        "terminate_engagement"
      ]
    },
    "arguments": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "object_id"],
        "properties": {
          "name": {
            "enum": [
              "repository_id",
              "profile_id",
              "test_case_id",
              "poc_id",
              "evidence_id",
              "finding_id",
              "patch_id",
              "test_suite_id",
              "scenario_id"
            ]
          },
          "object_id": {
            "type": "string",
            "pattern": "^(repo|prof|tc|poc|evd|fnd|pat|suite|scn)-[a-z0-9-]{3,64}$"
          }
        }
      }
    }
  }
}
