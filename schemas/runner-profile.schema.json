{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/runner-profile.schema.json",
  "title": "Runner Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_id", "test_case_id", "image_ref", "operations", "limits"],
  "properties": {
    "profile_id": {"type": "string", "pattern": "^prof-[a-z0-9-]{3,64}$"},
    "test_case_id": {"type": "string", "pattern": "^tc-[a-z0-9-]{3,64}$"},
    "image_ref": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64}|[a-z0-9][a-z0-9./_-]*@sha256:[a-f0-9]{64})$"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["read_repository", "static_analysis", "run_defined_tests", "collect_evidence"]}
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpus", "memory_mib", "timeout_seconds", "pids", "open_files", "max_file_bytes", "workspace_bytes", "evidence_bytes", "max_source_files"],
      "properties": {
        "cpus": {"type": "number", "minimum": 0.1, "maximum": 2.0},
        "memory_mib": {"type": "integer", "minimum": 64, "maximum": 1024},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600},
        "pids": {"type": "integer", "minimum": 8, "maximum": 128},
        "open_files": {"type": "integer", "minimum": 32, "maximum": 256},
        "max_file_bytes": {"type": "integer", "minimum": 1024, "maximum": 16777216},
        "workspace_bytes": {"type": "integer", "minimum": 1048576, "maximum": 134217728},
        "evidence_bytes": {"type": "integer", "minimum": 1024, "maximum": 16777216},
        "max_source_files": {"type": "integer", "minimum": 1, "maximum": 5000}
      }
    }
  }
}
